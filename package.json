{
  "name": "lideria-migracao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Base de migracao do LiderIA: Google Sheets -> PostgreSQL com Prisma ORM.",
  "engines": {
    "node": ">=20.19 <25"
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:check": "tsx src/check-db.ts",
    "migrate:sheets": "tsx scripts/import-xlsx.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "prisma": "7.10.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
